{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Data_csv",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${workspaceFolder}\\Data_csv.c",
                "-o",
                "${workspaceFolder}\\bin\\Data_csv.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Data_csv",
            "type": "process",
            "command": "${workspaceFolder}\\bin\\Data_csv.exe",
            "args": [
                "${input:csvPath}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build Data_csv",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}\\bin\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "inputs": [
        {
            "id": "csvPath",
            "type": "promptString",
            "description": "Chemin du fichier CSV",
            "default": "test.csv"
        }
    ]
}