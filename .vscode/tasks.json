{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build active C file",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run active C file",
            "type": "process",
            "command": "${workspaceFolder}\\${fileBasenameNoExtension}.exe",
            "args": [
                "${input:csvPath}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build active C file",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        }
    ],
    "inputs": [
        {
            "id": "csvPath",
            "type": "promptString",
            "description": "Chemin du fichier CSV",
            "default": "test.csv"
        }
    ]
}