{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GCC: deboguer le fichier actif",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\${fileBasenameNoExtension}.exe",
            "args": [
                "${input:csvPath}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "preLaunchTask": "Build active C file"
        }
    ],
    "inputs": [
        {
            "id": "csvPath",
            "type": "promptString",
            "description": "Chemin du fichier CSV",
            "default": "test.csv"
        }
    ]
}
